<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.3" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ortho.AuthController">
    <center>
        <VBox spacing="12.0" alignment="CENTER">
            <children>
                <Label text="Orthopedic Dictation" styleClass="title" />
                <Label text="Sign in to manage your profile and autotexts" />
                <Button text="Sign in with Google" onAction="#onGoogleSignIn" />
                <Label fx:id="statusLabel" text="" />
            </children>
            <padding><Insets top="32" bottom="32" left="32" right="32"/></padding>
        </VBox>
    </center>
</BorderPane>

